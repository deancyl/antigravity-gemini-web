    "text=/Verify it's you|验证您的身份|unusual traffic|异常流量/i"
  ],
  "quotaToastIndicators": [
    "[role='alert']",
    "[role='status']",
    ".mat-mdc-snack-bar-label",
    "text=/reached your limit|usage limit|已达上限|额度已用完|try again later/i"
