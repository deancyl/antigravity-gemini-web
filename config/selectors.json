{
  "_comment": "集中维护 Gemini 网页版语义化定位器；已对齐当前线上 gem-menu / Upload & tools 真实 DOM，页面改版时可直接热更新此文件。",
  "appUrl": "https://gemini.google.com/app",
  "loginIndicators": [
    "a[href*='accounts.google.com/ServiceLogin']",
    "button:has-text('Sign in')",
    "a:has-text('Sign in')",
    "button:has-text('登录')",
    "a:has-text('登录')"
